<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider path configuration for the self-update system.

    The update APKs are downloaded to cacheDir/updates/ which is
    exposed here as "update_apks". The FileProvider authority is
    ${applicationId}.fileprovider (declared in AndroidManifest.xml).
-->
<paths>
    <cache-path
        name="update_apks"
        path="updates/" />
</paths>
