{
  "name": "renz-fi-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,simulator -c blue,green \"npm run dev:client\" \"npm run dev:simulator\"",
    "dev:client": "vite --host",
    "dev:simulator": "tsx watch server/index.ts",
    "dev:server": "npm run dev:simulator",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "build": "npm run pwa:icons && cross-env EMBEDDED_BUILD=1 vite build",
    "build:web": "npm run pwa:icons && vite build",
    "build:openwrt": "npm run pwa:icons && vite build --config vite.config.openwrt.ts && node scripts/stage-openwrt-www.mjs",
    "typecheck": "tsc --noEmit",
    "build:esp32": "npm run build && node scripts/stage-esp32-data.mjs",
    "stage:esp32": "node scripts/stage-esp32-data.mjs",
    "deploy:esp32": "npm run build:esp32 && node scripts/deploy-esp32.mjs",
    "build:mikrotik-portal": "node scripts/build-mikrotik-portal.mjs",
    "check:captive-portal-sync": "node scripts/check-captive-portal-source-sync.mjs",
    "export:captive-portal": "node scripts/export-captive-portal.mjs",
    "test:portal": "node scripts/test-portal-resolver.mjs && node scripts/check-captive-portal-source-sync.mjs && node scripts/test-portal-session-lifecycle.mjs",
    "test:portal:lifecycle": "node scripts/check-captive-portal-source-sync.mjs && node scripts/test-portal-session-lifecycle.mjs",
    "simulator:check": "tsc -p server/tsconfig.json --noEmit",
    "simulator:migrate": "tsx server/db/migrate.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "react-router-dom": "^7.6.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "sharp": "^0.34.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.2"
  }
}
