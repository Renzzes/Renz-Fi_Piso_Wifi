# Frontend (optional — dev proxy handles /api by default)
# VITE_API_BASE=

# Backend
PORT=3001
DATA_DIR=./data
DB_PATH=./data/renz-fi.db
NODE_ENV=development

# Admin auth
ADMIN_SESSION_TTL_SECONDS=86400
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# SQLite
DB_BUSY_TIMEOUT_MS=5000
DB_BACKUP_RETENTION=7
DB_AUTO_BACKUP_HOURS=24
LOG_RETENTION_DAYS=30

# LAN security (optional - loopback/dev always allowed)
# LAN_SUBNET_RESTRICTION=false
# LAN_ALLOWED_SUBNETS=10.10.10.0/24
# LAN_IP_ALLOWLIST=false
# LAN_ALLOWED_IPS=10.10.10.1

# CSRF (optional, disabled by default)
# CSRF_ENABLED=false
